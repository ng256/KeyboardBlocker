#include "resource.h"

IDI_ICON32      ICON    "icon32.ico"
IDI_ICON16      ICON    "icon16.ico"

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Pavel Bashkarin"
            VALUE "FileDescription",  "Keyboard Blocker"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "keyblock"
            VALUE "OriginalFilename", "keyblock.exe"
            VALUE "ProductName",      "Keyboard Blocker"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
